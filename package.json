{
          "name": "com.dsb.gamingcouch",
          "version": "0.1.0-alpha.5",
          "displayName": "Gaming Couch",
          "description": "Integrate Unity game with Gaming Couch platform.",
          "unity": "6000.0",
          "documentationUrl": "https://deadsetbit.github.io/gaming-couch-unity/",
          "changelogUrl": "https://github.com/deadsetbit/gaming-couch-unity/blob/main/CHANGELOG.md",
          "licensesUrl": "https://github.com/deadsetbit/gaming-couch-unity/blob/main/LICENSE.md",
          "dependencies": {
                    "com.unity.nuget.newtonsoft-json": "3.2.1"
          },
          "keywords": [
                    "gaming-couch",
                    "unity",
                    "webgl",
                    "local-multiplayer"
          ],
          "author": {
                    "name": "DSB",
                    "email": "info@deadsetbit.com",
                    "url": "https://deadsetbit.com/"
          },
          "scripts": {
                    "release:patch": "python3 Tools/bump-version.py patch",
                    "release:minor": "python3 Tools/bump-version.py minor",
                    "release:major": "python3 Tools/bump-version.py major",
                    "release:prerelease": "python3 Tools/bump-version.py prerelease",
                    "release:alpha": "python3 Tools/bump-version.py prerelease --preid=alpha",
                    "release:beta": "python3 Tools/bump-version.py prerelease --preid=beta",
                    "release:dry": "python3 Tools/bump-version.py prerelease --preid=alpha --dry-run"
          }
}
